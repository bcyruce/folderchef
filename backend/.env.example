# ============================================================
# FolderChef Backend — Environment Variables
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real values below
#   3. NEVER commit the .env file to Git!
# ============================================================

# --- Database ---
# The URL to connect to your PostgreSQL database.
# For local development, you might use:
#   postgresql+asyncpg://postgres:password@localhost:5432/folderchef
# Railway will provide this automatically.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/folderchef

# --- OpenAI API ---
# Your OpenAI API key for recipe generation.
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# --- App Settings ---
# The environment the app is running in (development / production)
ENVIRONMENT=development

# Enable debug mode (shows detailed error messages)
DEBUG=true

# Secret key for signing tokens (change this to a random string!)
SECRET_KEY=change-me-to-a-random-secret-string

# --- CORS ---
# Allowed origins for cross-origin requests (your frontend URL)
# Separate multiple origins with commas
FRONTEND_URL=http://localhost:3000
